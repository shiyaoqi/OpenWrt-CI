{
	"luci-app-wbclean": {
		"description": "允许 WB 离线客户端清理、日志清空与 DHCP 改名按钮运行受限脚本",
		"read": {
			"ubus": {
				"file": [ "exec", "stat" ]
			},
			"file": {
				"/usr/bin/wb-clean-clients*": [ "exec" ],
				"/usr/bin/wb-clear-logs*": [ "exec" ],
				"/usr/bin/wb-dhcp*": [ "exec" ],
				"/tmp/dhcp.leases": [ "read", "write" ],
				"/tmp/odhcpd.leases": [ "read", "write" ]
			}
		},
		"write": {
			"ubus": {
				"file": [ "exec" ]
			},
			"file": {
				"/usr/bin/wb-clean-clients*": [ "exec" ],
				"/usr/bin/wb-clear-logs*": [ "exec" ],
				"/usr/bin/wb-dhcp*": [ "exec" ],
				"/tmp/dhcp.leases": [ "write" ],
				"/tmp/odhcpd.leases": [ "write" ]
			}
		}
	}
}
