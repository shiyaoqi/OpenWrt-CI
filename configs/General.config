### 通用配置文件 ###

CONFIG_CCACHE=y
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_LUCI_LANG_zh_Hant=y

# CONFIG_FEED_video is not set
# CONFIG_FEED_nss_packages is not set
# CONFIG_FEED_sqm_scripts_nss is not set
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-lib-lz4=y
CONFIG_KERNEL_ZRAM_BACKEND_LZ4=y
CONFIG_KERNEL_ZRAM_BACKEND_LZO=y
CONFIG_KERNEL_ZRAM_DEF_COMP_LZ4=y

CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_dmesg=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_btop=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_cfdisk=n
CONFIG_PACKAGE_sgdisk=n
CONFIG_PACKAGE_tune2fs=y
CONFIG_PACKAGE_fstrim=y
CONFIG_PACKAGE_nano-full=y
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_coremark=y
CONFIG_PACKAGE_hdparm=y
CONFIG_PACKAGE_smartmontools-drivedb=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_acme-acmesh-dnsapi=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_sqm-scripts-nss=n

CONFIG_PACKAGE_luci-theme-aurora=y               # 启用 Aurora 主题
CONFIG_PACKAGE_luci-app-aurora-config=n          # Aurora 主题配置页
CONFIG_PACKAGE_luci-app-acme=y                   # ACME 自动证书管理界面
CONFIG_PACKAGE_luci-app-ddns-go=y                # 动态DNS配置界面
CONFIG_PACKAGE_luci-app-upnp=y                   # UPnP服务管理界面
CONFIG_PACKAGE_luci-app-wol=y                    # 网络唤醒 (WOL) 界面
CONFIG_PACKAGE_luci-app-samba4=y                 # Samba4网络共享界面
CONFIG_PACKAGE_luci-app-vlmcsd=n                 # KMS激活服务界面
CONFIG_PACKAGE_luci-app-autoreboot=y             # 定时重启界面
CONFIG_PACKAGE_luci-app-cpufreq=y                # CPU 频率调节界面
CONFIG_PACKAGE_luci-app-uhttpd=n                 # uHTTPd Web 服务器管理
CONFIG_PACKAGE_luci-app-frps=n                   # frp 服务端界面
CONFIG_PACKAGE_luci-app-frpc=n                   # frp 客户端界面
CONFIG_PACKAGE_luci-app-diskman=y                # 磁盘管理界面
CONFIG_PACKAGE_luci-app-hd-idle=y                # 硬盘空闲停转设置
CONFIG_PACKAGE_luci-app-3cat=y                   # 3cat 网络工具界面
CONFIG_PACKAGE_luci-app-watchcat=y               # 看门狗重启监控界面
CONFIG_PACKAGE_luci-proto-wireguard=n            # WireGuard 协议支持

CONFIG_PACKAGE_luci-theme-argon=n                # Argon 主题
CONFIG_PACKAGE_luci-app-argon-config=n           # Argon 主题配置
CONFIG_PACKAGE_luci-app-banip=n                  # IP 黑名单插件
CONFIG_PACKAGE_luci-app-arpbind=n                # ARP 绑定插件
CONFIG_PACKAGE_luci-app-usb-printer=n            # USB 打印服务
CONFIG_PACKAGE_luci-app-oaf=n                    # 应用过滤插件
CONFIG_PACKAGE_luci-app-sqm=n                    # SQM 流量整形界面
CONFIG_PACKAGE_luci-app-ttyd=y                   # 网页终端 ttyd
CONFIG_PACKAGE_luci-app-wechatpush=n             # 微信推送
CONFIG_PACKAGE_luci-app-smartdns=n               # SmartDNS 界面
CONFIG_PACKAGE_luci-app-lucky=n                  # Lucky 插件
CONFIG_PACKAGE_luci-app-openclash=n              # OpenClash
CONFIG_PACKAGE_luci-app-passwall2=n              # PassWall2
CONFIG_PACKAGE_luci-app-wifischedule=n           # WiFi 定时开关
CONFIG_PACKAGE_luci-app-zerotier=y               # ZeroTier内网穿透
CONFIG_PACKAGE_luci-app-homeproxy=n


### PassWall配置项 ###

CONFIG_PACKAGE_luci-app-passwall=n
# CONFIG_PACKAGE_luci-app-passwall_Iptables_Transparent_Proxy is not set
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Geoview=n
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Libev_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Trojan_Plus is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_tuic_client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin is not set
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=n
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin is not set


# ===== WorkBuddy v2 插件配置 · 从 0 刷机 / 上行中性 / 精简版  2026-11-09 =====
# 用法：把本段【追加到 configs/General.config 末尾】，提交后触发 JDCloud-ImmortalWrt。
# 依据：Build-OpenWrt.yml:257 用 cat JDCloud.config General.config > .config，
#       General 在后，同名符号后写覆盖前写；Roc-script.sh 的 package_enabled
#       也按同样顺序扫描两份配置，因此这里设 =n 会同时阻止第三方 git clone。
# 原则：官方 feed 里的纯界面/小工具才「编进去备用」；带 kmod 或触发 clone 的
#       一律排除，避免与 NSS 全功能加速冲突、拖长编译。
# 留 watchcat / 删 autoreboot：按需自愈优于定时重启；定时重启可用一行 cron 代替。

# --- 代理 / 隧道 / 组网 ------------------------------------------------------
# luci-app-openclash 由 immortalwrt/luci feed 自带（0.48.002），无需 clone 第三方仓库。
# 内核二进制由 scripts/wb-fixes.sh 在编译期注入 files/etc/openclash/core/。
CONFIG_PACKAGE_luci-app-openclash=y
# EasyTier：JDCloud.config:16 原本只有 luci-app-easytier=y，但源里没这个包，
# 由 wb-fixes.sh 补入官方包源；easytier 是主程序，必须一并显式启用。
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_easytier=y
# CONFIG_EASYTIER_INCLUDE_WEBCONSOLE is not set
CONFIG_PACKAGE_luci-app-zerotier=n
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-passwall2=n
CONFIG_PACKAGE_luci-app-homeproxy=n
CONFIG_PACKAGE_luci-app-lucky=n
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-app-frps=n
CONFIG_PACKAGE_luci-proto-wireguard=n
CONFIG_PACKAGE_luci-app-smartdns=n
CONFIG_PACKAGE_luci-app-vlmcsd=n

# --- 网络控制 ----------------------------------------------------------------
CONFIG_PACKAGE_luci-app-oaf=n
CONFIG_PACKAGE_luci-app-sqm=n
CONFIG_PACKAGE_sqm-scripts-nss=n
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-app-autoreboot=n
CONFIG_PACKAGE_luci-app-banip=n
CONFIG_PACKAGE_luci-app-arpbind=n
CONFIG_PACKAGE_luci-app-wifischedule=n

# --- 存储 / 共享 / 打印（NAS 场景保留）---------------------------------------
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-hd-idle=y
CONFIG_PACKAGE_luci-app-p910nd=y
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_luci-app-usb-printer=n
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_cfdisk=n
CONFIG_PACKAGE_sgdisk=n
CONFIG_PACKAGE_tune2fs=y
